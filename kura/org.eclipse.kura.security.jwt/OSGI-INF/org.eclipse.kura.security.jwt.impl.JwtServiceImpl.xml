<scr:component xmlns:scr="http://www.osgi.org/xmlns/scr/v1.1.0" activate="activate" configuration-policy="require" deactivate="update" immediate="true" name="org.eclipse.kura.security.jwt.impl.JwtServiceImpl">
   <implementation class="org.eclipse.kura.security.jwt.impl.JwtServiceImpl"/>
   <property name="service.pid" type="String" value="org.eclipse.kura.security.jwt.impl.JwtServiceImpl"/>
   <reference bind="setKeystoreService" cardinality="0..1" interface="org.eclipse.kura.security.keystore.KeystoreService" name="KeystoreService" policy="dynamic" unbind="unsetKeystoreService"/>
