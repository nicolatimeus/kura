 com.auth0.jwt.algorithms;version="4.4.0",
 com.auth0.jwt.exceptions;version="4.4.0",
 com.auth0.jwt.interfaces;version="4.4.0",
 org.eclipse.kura.security.jwt;version="1.0.0";x-internal:=true
Require-Capability: osgi.ee;filter:="(&(osgi.ee=JavaSE)(version=1.8))"
Bundle-ClassPath: .,
 lib/java-jwt.jar,
 lib/jackson-annotations.jar,
 lib/jackson-core.jar,
 lib/jackson-databind.jar
Bundle-ActivationPolicy: lazy
Import-Package: javax.annotation;version="1.2.0",
 javax.servlet;version="3.1.0",
 javax.servlet.http;version="3.1.0",
 javax.ws.rs;version="2.0.1",
 javax.ws.rs.container;version="2.0.1",
 javax.ws.rs.core;version="2.0.1",
 org.eclipse.kura;version="[1.7,2.0)",
 org.eclipse.kura.audit;version="1.0.0",
 org.eclipse.kura.configuration;version="1.2.0",
 org.eclipse.kura.crypto;version="1.3.0",
 org.eclipse.kura.rest.auth;version="1.0.0",
 org.eclipse.kura.security.keystore;version="[1.1,2.0)",
 org.osgi.service.event;version="1.4.0",
 org.osgi.service.useradmin;version="1.1.0",
 org.slf4j;version="1.7.36"
Service-Component: OSGI-INF/*.xml

