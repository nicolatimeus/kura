Manifest-Version: 1.0
Bundle-ManifestVersion: 2
Bundle-Name: org.eclipse.kura.security.jwt
Bundle-SymbolicName: org.eclipse.kura.security.jwt;singleton:=true
Bundle-Version: 1.0.0.qualifier
